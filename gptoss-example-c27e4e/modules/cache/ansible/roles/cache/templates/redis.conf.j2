{% if job_control == 'initd' or job_control == 'rcinit' %}
daemonize yes
{% endif %}

pidfile {{ piddir }}/redis_{{ name }}.pid
port {{ port }}

tcp-backlog {{ tcpbacklog }}

{% if address is defined %}
bind {{ address }}
{% endif %}

{% if protected_mode is defined %}
protected-mode {{ protected_mode }}
{% endif %}

