#!/bin/sh
### BEGIN INIT INFO
# Provides:          redis{{ redis_name }}
# Required-Start:    {{ redis_required_start }}
# Required-Stop:     {{ redis_required_stop }}
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO
case "$1" in
  start) {{ redis_bin_path }}/redis-server {{ redis_config_dir }}/{{ redis_name }}.conf ;;
  stop) {{ redis_bin_path }}/redis-cli -p {{ redis_port }} shutdown ;;
  restart) $0 stop; $0 start ;;
  *) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
