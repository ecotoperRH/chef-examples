[Unit]
Description=Redis instance %i
After=network.target

[Service]
Type=notify
User={{ redis_user }}
Group={{ redis_group }}
ExecStart={{ redis_bin_path }}/redis-server /etc/redis/%i.conf
ExecStop={{ redis_bin_path }}/redis-cli -p %i shutdown
LimitNOFILE={{ redis_limit_nofile }}
Restart=on-failure

[Install]
WantedBy=multi-user.target
