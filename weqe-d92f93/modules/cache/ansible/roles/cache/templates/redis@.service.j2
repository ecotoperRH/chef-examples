[Unit]
Description=Redis (%i) persistent key-value database
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ redis_svc_bin_path }}/redis-server /etc/redis/%i.conf --daemonize no
User={{ redis_svc_user }}
Group={{ redis_svc_group }}
LimitNOFILE={{ redis_svc_limit_nofile }}

[Install]
WantedBy=multi-user.target
