description "Start the redis instance on port {{ redis_upstart_port }}"
author "Installed by ansible cache role"

#start on runlevel [2345]
stop on runlevel [06]

script
  if [ ! -d {{ redis_upstart_piddir }} ]; then
    mkdir -p {{ redis_upstart_piddir }}
    chown {{ redis_upstart_user }}:{{ redis_upstart_group }}  {{ redis_upstart_piddir }}
  fi
end script

# If the job exits, restart it. Give up with more than 10 restarts in 30 seconds.
respawn
respawn limit 10 30

exec su -s /bin/sh -c 'exec "$0" "$@"' {{ redis_upstart_user }} {{ redis_upstart_bin_path }}/redis-server {{ redis_upstart_configdir }}/{{ redis_upstart_name }}.conf
