#!/bin/sh
# Redis init.d script.
# Provides: redis{{ redis_port }}
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Required-Start: {{ redis_required_start }}
# Required-Stop: {{ redis_required_stop }}
# Description: redis{{ redis_port }} init script

REDISNAME={{ redis_name }}
REDISPORT={{ redis_port }}
EXEC="su -s /bin/sh -c '{{ redis_bin_path }}/redis-server {{ redis_configdir }}/${REDISNAME}.conf' {{ redis_user }}"
CLIEXEC={{ redis_bin_path }}/redis-cli
{% if redis_unixsocket is none %}CONNECTION=" -p {{ redis_port }}{% if redis_address %} -h {{ redis_address[0] if redis_address is iterable and redis_address is not string else redis_address }}{% endif %}"{% else %}CONNECTION=" -s {{ redis_unixsocket }}"{% endif %}
{% if redis_requirepass is not none %}CONNECTION="$CONNECTION -a '{{ redis_requirepass }}'"{% endif %}
PIDFILE={{ redis_piddir }}/redis_${REDISNAME}.pid

if [ ! -d {{ redis_piddir }} ]; then
    mkdir -p {{ redis_piddir }}
    chown {{ redis_user }} {{ redis_piddir }}
fi
ulimit -n {{ redis_ulimit }}

case "$1" in
    status)
        test -f "$PIDFILE" || exit 3
        ps -p "$(cat "$PIDFILE")" >/dev/null 2>&1
        ;;
    start)
        if [ -f "$PIDFILE" ]; then
            PIDNUM=$(cat "$PIDFILE")
            if ! ps --no-headers -q "$PIDNUM" >/dev/null 2>&1; then
                rm -f "$PIDFILE"
                eval "$EXEC"
            fi
        else
            eval "$EXEC"
        fi
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
{% if redis_shutdown_save %}            $CLIEXEC $CONNECTION save
{% endif %}            $CLIEXEC $CONNECTION shutdown
        fi
        ;;
    *)
        echo "Please use start or stop as first argument"
        exit 1
        ;;
esac
