description "Start the redis instance on port {{ redis_port }}"
author "Installed by Ansible cache role"

#start on runlevel [2345]
stop on runlevel [06]

script
  if [ ! -d {{ redis_piddir }} ]; then
    mkdir -p {{ redis_piddir }}
    chown {{ redis_user }}:{{ redis_group }} {{ redis_piddir }}
  fi
end script

respawn
respawn limit 10 30

exec su -s /bin/sh -c 'exec "$0" "$@"' {{ redis_user }} {{ redis_bin_path }}/redis-server {{ redis_configdir }}/{{ redis_name }}.conf
