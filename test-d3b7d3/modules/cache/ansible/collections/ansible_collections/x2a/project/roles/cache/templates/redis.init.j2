#!/bin/sh
# Redis init script for instance {{ cache_redis_name }}.
### BEGIN INIT INFO
# Provides: redis{{ cache_redis_port }}
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Required-Start: {{ cache_redis_required_start }}
# Required-Stop: {{ cache_redis_required_stop }}
# Description: redis{{ cache_redis_port }} init script
### END INIT INFO

REDISNAME={{ cache_redis_name }}
REDISPORT={{ cache_redis_port }}
EXEC="{{ cache_redis_bin_path }}/redis-server {{ cache_redis_config_dir }}/${REDISNAME}.conf"
CLIEXEC={{ cache_redis_bin_path }}/redis-cli
PIDFILE={{ cache_redis_pid_dir }}/redis_${REDISNAME}.pid

case "$1" in
    status)
        if [ -f "$PIDFILE" ]; then
            ps -p "$(cat "$PIDFILE")" >/dev/null 2>&1
            exit $?
        fi
        exit 3
        ;;
    start)
        mkdir -p "{{ cache_redis_pid_dir }}"
        chown {{ cache_redis_user }} "{{ cache_redis_pid_dir }}"
        ulimit -n {{ cache_redis_ulimit }}
        su -s /bin/sh -c "$EXEC" {{ cache_redis_user }}
        ;;
    stop)
        if [ -f "$PIDFILE" ]; then
            {{ cache_redis_bin_path }}/redis-cli -p "$REDISPORT"{% if cache_redis_requirepass is not none %} -a '{{ cache_redis_requirepass }}'{% endif %} shutdown
        fi
        ;;
    *)
        echo "Please use start, stop, or status as first argument"
        exit 1
        ;;
esac
