[Unit]
Description=Redis (%i) persistent key-value database
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ cache_redis_install_dir }}/bin/redis-server /etc/redis/%i.conf --daemonize no
User={{ cache_redis_user }}
Group={{ cache_redis_group }}
LimitNOFILE={{ cache_redis_maxclients + 32 }}

[Install]
WantedBy=multi-user.target
