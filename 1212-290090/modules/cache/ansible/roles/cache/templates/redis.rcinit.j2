#!/bin/sh
# PROVIDE: redis{{ cache_redis_port }}
# REQUIRE: LOGIN
. /etc/rc.subr

name="redis{{ cache_redis_port }}"
rcvar="${name}_enable"
command="{{ cache_redis_install_dir }}/bin/redis-server"
pidfile="{{ cache_redis_pid_dir }}/redis_{{ cache_redis_port }}.pid"
load_rc_config "$name"
: ${redis{{ cache_redis_port }}_enable="NO"}
: ${redis_user="{{ cache_redis_user }}"}
: ${redis_config="{{ cache_redis_config_file }}"}
command_args="${redis_config}"
required_files="${redis_config}"
run_rc_command "$1"
