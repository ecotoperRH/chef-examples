# Redis configuration generated by the cache role.
{% if cache_redis_job_control in ['initd', 'rcinit'] %}
daemonize yes
{% endif %}pidfile {{ cache_redis_pid_dir }}/redis_6379.pid
port {{ cache_redis_port }}
tcp-backlog 511
{% if cache_redis_bind %}bind {{ cache_redis_bind }}
{% endif %}protected-mode yes
timeout 0
tcp-keepalive 300
loglevel {{ cache_redis_loglevel }}
logfile {{ cache_redis_log_dir }}/redis-6379.log
syslog-enabled {{ cache_redis_syslog_enabled }}
syslog-ident redis-6379
syslog-facility {{ cache_redis_syslog_facility }}
databases {{ cache_redis_databases }}
{% for item_cache_save in cache_redis_save %}save {{ item_cache_save }}
{% endfor %}stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump-6379.rdb
dir {{ cache_redis_data_dir }}
replica-serve-stale-data
auth-warning no
requirepass {{ redis_requirepass }}
maxclients {{ cache_redis_maxclients }}
maxmemory-policy noeviction
appendonly no
appendfilename appendonly-6379.aof
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb
aof-load-truncated yes
lua-time-limit 5000
slowlog-log-slower-than 10000
slowlog-max-len 128
notify-keyspace-events ""
hash-max-ziplist-entries 512
hash-max-ziplist-value 64
set-max-intset-entries 512
zset-max-ziplist-entries 128
zset-max-ziplist-value 64
hll-sparse-max-bytes 3000
activerehashing yes
hz 10
aof-rewrite-incremental-fsync yes
