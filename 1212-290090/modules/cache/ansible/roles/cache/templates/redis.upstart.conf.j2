description "Start the redis instance on port {{ cache_redis_port }}"
author "Installed by Ansible"
start on runlevel [2345]
stop on runlevel [06]
script
  mkdir -p {{ cache_redis_pid_dir }}
  chown {{ cache_redis_user }}:{{ cache_redis_group }} {{ cache_redis_pid_dir }}
end script
respawn
respawn limit 10 30
exec {{ cache_redis_bin_path }}/redis-server {{ cache_redis_config_dir }}/{{ cache_redis_name }}.conf
