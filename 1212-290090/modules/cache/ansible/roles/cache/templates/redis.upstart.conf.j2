description "Start the redis instance on port {{ cache_redis_port }}"
author "Installed by Ansible cache role"

start on runlevel [2345]
stop on runlevel [06]

script
  if [ ! -d {{ cache_redis_pid_dir }} ]; then
    mkdir -p {{ cache_redis_pid_dir }}
    chown {{ cache_redis_user }}:{{ cache_redis_group }} {{ cache_redis_pid_dir }}
  fi
end script

respawn
respawn limit 10 30

exec su -s /bin/sh -c 'exec "$0" "$@"' {{ cache_redis_user }} {{ cache_redis_bin_path }}/redis-server {{ cache_redis_config_dir }}/{{ cache_redis_name }}.conf
