# Redis configuration for instance {{ cache_redis_instance_name }}.
# Generated by Ansible; changes will be overwritten.
{% if cache_redis_service_manager in ['initd', 'rcinit'] %}
daemonize yes
{% endif %}
pidfile {{ cache_redis_pid_dir }}/redis_{{ cache_redis_instance_name }}.pid
port {{ cache_redis_port }}
tcp-backlog {{ cache_redis_tcp_backlog }}
{% if cache_redis_bind_address is not none %}
bind {{ cache_redis_bind_address | join(' ') if cache_redis_bind_address is sequence and cache_redis_bind_address is not string else cache_redis_bind_address }}
{% endif %}
protected-mode {{ cache_redis_protected_mode }}
timeout {{ cache_redis_timeout }}
tcp-keepalive {{ cache_redis_keepalive }}
loglevel {{ cache_redis_loglevel }}
logfile {{ cache_redis_log_file }}
syslog-enabled {{ cache_redis_syslog_enabled }}
syslog-ident redis-{{ cache_redis_instance_name }}
syslog-facility {{ cache_redis_syslog_facility }}
databases {{ cache_redis_databases }}
{% for item_cache_save in cache_redis_save %}
save {{ item_cache_save }}
{% endfor %}
stop-writes-on-bgsave-error {{ cache_redis_stop_writes_on_bgsave_error }}
rdbcompression {{ cache_redis_rdb_compression }}
rdbchecksum {{ cache_redis_rdb_checksum }}
dbfilename {{ cache_redis_db_filename }}
dir {{ cache_redis_data_dir }}
{% if cache_redis_replicaof is not none %}
replicaof {{ cache_redis_replicaof['address'] }} {{ cache_redis_replicaof['port'] }}
{% endif %}
replica-serve-stale-data {{ cache_redis_replica_serve_stale_data }}
replica-read-only {{ cache_redis_replica_read_only }}
repl-diskless-sync {{ cache_redis_repl_diskless_sync }}
repl-diskless-sync-delay {{ cache_redis_repl_diskless_sync_delay }}
repl-ping-replica-period {{ cache_redis_repl_ping_replica_period }}
repl-timeout {{ cache_redis_repl_timeout }}
repl-disable-tcp-nodelay {{ cache_redis_repl_disable_tcp_nodelay }}
repl-backlog-size {{ cache_redis_repl_backlog_size }}
repl-backlog-ttl {{ cache_redis_repl_backlog_ttl }}
replica-priority {{ cache_redis_replica_priority }}
requirepass {{ redis_password }}
maxclients {{ cache_redis_max_clients }}
{% if cache_redis_max_memory | length > 0 %}
maxmemory {{ cache_redis_max_memory }}
{% endif %}
maxmemory-policy {{ cache_redis_max_memory_policy }}
maxmemory-samples {{ cache_redis_max_memory_samples }}
appendonly {{ cache_redis_appendonly }}
appendfilename {{ cache_redis_append_filename }}
appendfsync {{ cache_redis_append_fsync }}
no-appendfsync-on-rewrite {{ cache_redis_no_appendfsync_on_rewrite }}
auto-aof-rewrite-percentage {{ cache_redis_aof_rewrite_percentage }}
auto-aof-rewrite-min-size {{ cache_redis_aof_rewrite_min_size }}
aof-load-truncated {{ cache_redis_aof_load_truncated }}
lua-time-limit {{ cache_redis_lua_time_limit }}
slowlog-log-slower-than {{ cache_redis_slowlog_log_slower_than }}
slowlog-max-len {{ cache_redis_slowlog_max_len }}
notify-keyspace-events "{{ cache_redis_notify_keyspace_events }}"
hash-max-ziplist-entries {{ cache_redis_hash_max_ziplist_entries }}
hash-max-ziplist-value {{ cache_redis_hash_max_ziplist_value }}
set-max-intset-entries {{ cache_redis_set_max_intset_entries }}
zset-max-ziplist-entries {{ cache_redis_zset_max_ziplist_entries }}
zset-max-ziplist-value {{ cache_redis_zset_max_ziplist_value }}
hll-sparse-max-bytes {{ cache_redis_hll_sparse_max_bytes }}
activerehashing {{ cache_redis_active_rehashing }}
{% for item_cache_buffer_limit in cache_redis_client_output_buffer_limits %}
client-output-buffer-limit {{ item_cache_buffer_limit }}
{% endfor %}
hz {{ cache_redis_hz }}
aof-rewrite-incremental-fsync {{ cache_redis_aof_rewrite_incremental_fsync }}
