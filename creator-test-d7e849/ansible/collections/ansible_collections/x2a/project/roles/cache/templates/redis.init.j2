#!/bin/sh
# Redis init script for instance {{ cache_redis_instance_name }}.
### BEGIN INIT INFO
# Provides: redis{{ cache_redis_port }}
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Required-Start: {{ cache_redis_required_start }}
# Required-Stop: {{ cache_redis_required_stop }}
# Description: redis{{ cache_redis_port }} init script
### END INIT INFO

REDISNAME={{ cache_redis_instance_name }}
REDISPORT={{ cache_redis_port }}
{% if ansible_facts['distribution'] | lower in ['ubuntu', 'debian', 'fedora'] %}
EXEC="su -s /bin/sh -c '{{ cache_redis_bin_path }}/redis-server {{ cache_redis_config_dir }}/${REDISNAME}.conf' {{ cache_redis_user }}"
{% else %}
EXEC="runuser {{ cache_redis_user }} -c \"{{ cache_redis_bin_path }}/redis-server {{ cache_redis_config_dir }}/${REDISNAME}.conf\""
{% endif %}
CLIEXEC={{ cache_redis_bin_path }}/redis-cli
PIDFILE={{ cache_redis_pid_dir }}/redis_${REDISNAME}.pid

if [ ! -d {{ cache_redis_pid_dir }} ]; then
    mkdir -p {{ cache_redis_pid_dir }}
    chown {{ cache_redis_user }} {{ cache_redis_pid_dir }}
fi

ulimit -n {{ cache_redis_limit_nofile }}

case "$1" in
    status)
        [ -f "$PIDFILE" ] && ps -p "$(cat "$PIDFILE")" >/dev/null 2>&1
        exit $?
        ;;
    start)
        eval "$EXEC"
        ;;
    stop)
{% if cache_redis_shutdown_save %}
        "$CLIEXEC" -p "$REDISPORT" save
{% endif %}
        "$CLIEXEC" -p "$REDISPORT" shutdown
        ;;
    *)
        echo "Please use start or stop as first argument"
        exit 1
        ;;
esac
