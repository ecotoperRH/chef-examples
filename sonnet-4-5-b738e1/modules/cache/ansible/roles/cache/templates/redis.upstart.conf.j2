description "Start the redis instance on port {{ cache_redis_port }}"
author "Installed by ansible cache role"

#start on runlevel [2345]
stop on runlevel [06]

script
  if [ ! -d {{ cache_redis_piddir }} ]; then
    mkdir -p {{ cache_redis_piddir }}
    chown {{ cache_redis_user }}:{{ cache_redis_group }}  {{ cache_redis_piddir }}
  fi
end script

# If the job exits, restart it. Give up with more than 10 restarts in 30 seconds.
respawn
respawn limit 10 30

exec su -s /bin/sh -c 'exec "$0" "$@"' {{ cache_redis_user }} {{ cache_redis_bin_path }}/redis-server {{ cache_redis_configdir }}/{{ cache_redis_name }}.conf
