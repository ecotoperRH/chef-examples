[Unit]
Description=Redis ({{ name }}) persistent key-value database
Wants=network-online.target
After=network-online.target

[Service]
ExecStart={{ bin_path }}/redis-server /etc/redis/{{ name }}.conf --daemonize no
User={{ user }}
Group={{ group }}
LimitNOFILE={{ limit_nofile }}

[Install]
WantedBy=multi-user.target