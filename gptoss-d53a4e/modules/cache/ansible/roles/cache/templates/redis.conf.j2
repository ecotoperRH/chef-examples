# Redis configuration file generated by Ansible

# Note on units: when memory size is needed, it is possible to specify
# it in the usual form of 1k 5GB 4M and so forth:
#
# 1k => 1000 bytes
# 1kb => 1024 bytes
# 1m => 1000000 bytes
# 1mb => 1024*1024 bytes
# 1g => 1000000000 bytes
# 1gb => 1024*1024*1024 bytes
#
# units are case insensitive so 1GB 1Gb 1gB are all the same.

# By default Redis does not run as a daemon. Use 'yes' if you need it.
# Note that Redis will write a pid file in /var/run/redis.pid when daemonized.
{% if job_control == 'initd' or job_control == 'rcinit' %}
daemonize yes
{% endif %}

# When running daemonized, Redis writes a pid file in /var/run/redis.pid
# by default. You can specify a custom pid file location here.
pidfile {{ piddir }}/redis_{{ name }}.pid

# Accept connections on the specified port, default is 6379.
# If port 0 is specified Redis will not listen on a TCP socket.
port {{ port }}

# TCP listen() backlog.
# In high requests-per-second environments you need a high backlog ...
# make sure to raise both the value of somaxconn and tcp_max_syn_backlog
# in order to get the desired effect.
{{ tcpbacklog }}

# By default Redis listens for connections from all the network interfaces
# available on the server. It is possible to listen to just one or multiple
# interfaces using the "bind" configuration directive.
{% if address is defined and address %}
{{ "bind " + (address if address is string else address | join(' ')) }}
{% endif %}

# Protected mode is a layer of security protection ...
{% if protected_mode is defined %}
protected-mode {{ protected_mode }}
{% endif %}

# Specify the path for the Unix socket that will be used to listen for
# incoming connections.
{% if unixsocket is defined %}
unixsocket {{ unixsocket }}
{% endif %}
{% if unixsocketperm is defined %}
unixsocketperm {{ unixsocketperm }}
{% endif %}

# Close the connection after a client is idle for N seconds (0 to disable)
{{ "timeout " + timeout }}

# TCP keepalive.
{{ "tcp-keepalive " + keepalive }}

# Set server verbosity to 'debug'
loglevel {{ loglevel }}

# Specify the log file name. Also 'stdout' can be used to force
# Redis to log on the standard output.
{% if logfile is defined %}
logfile {{ logfile }}
{% endif %}

# To enable logging to the system logger
syslog-enabled {{ syslogenabled }}

# Specify the syslog identity.
syslog-ident redis-{{ name }}

# Specify the syslog facility.
syslog-facility {{ syslogfacility }}

# Set the number of databases.
databases {{ databases }}

# TLS/SSL configuration
{% if tlsport is defined %}
tls-port {{ tlsport }}
{% endif %}
{% if tlscertfile is defined %}
tls-cert-file {{ tlscertfile }}
{% endif %}
{% if tlskeyfile is defined %}
tls-key-file {{ tlskeyfile }}
{% endif %}
{% if tlskeyfilepass is defined %}
tls-key-file-pass {{ tlskeyfilepass }}
{% endif %}
{% if tlsclientcertfile is defined %}
tls-client-cert-file {{ tlsclientcertfile }}
{% endif %}
{% if tlsclientkeyfile is defined %}
tls-client-key-file {{ tlsclientkeyfile }}
{% endif %}
{% if tlsclientkeyfilepass is defined %}
tls-client-key-file-pass {{ tlsclientkeyfilepass }}
{% endif %}
{% if tlsdhparamsfile is defined %}
tls-dh-params-file {{ tlsdhparamsfile }}
{% endif %}
{% if tlscacertfile is defined %}
tls-ca-cert-file {{ tlscacertfile }}
{% endif %}
{% if tlscacertdir is defined %}
tls-ca-cert-dir {{ tlscacertdir }}
{% endif %}
{% if tlsauthclients is defined %}
tls-auth-clients {{ tlsauthclients }}
{% endif %}
{% if tlsreplication is defined %}
tls-replication {{ tlsreplication }}
{% endif %}
{% if tlscluster is defined %}
tls-cluster {{ tlscluster }}
{% endif %}
{% if tlsprotocols is defined %}
tls-protocols {{ tlsprotocols }}
{% endif %}
{% if tlsciphers is defined %}
tls-ciphers {{ tlsciphers }}
{% endif %}
{% if tlsciphersuites is defined %}
tls-ciphersuites {{ tlsciphersuites }}
{% endif %}
{% if tlspreferserverciphers is defined %}
tls-prefer-server-ciphers {{ tlspreferserverciphers }}
{% endif %}
{% if tlssessioncaching is defined %}
tls-session-caching {{ tlssessioncaching }}
{% endif %}
{% if tlssessioncachesize is defined %}
tls-session-cache-size {{ tlssessioncachesize }}
{% endif %}
{% if tlssessioncachetimeout is defined %}
tls-session-cache-timeout {{ tlssessioncachetimeout }}
{% endif %}

# Persistence configuration
{% if backuptype == 'rdb' or backuptype == 'both' %}
{{ "save 900 1" if save is not defined else '' }}
{{ "save 300 10" if save is not defined else '' }}
{{ "save 60 10000" if save is not defined else '' }}
{% if save is defined %}
{% for save_option in save %}
save {{ save_option }}
{% endfor %}
{% endif %}
{% endif %}

{% if version.major|int >= 2 and version.minor|int >= 6 or version.major|int >= 3 %}
stop-writes-on-bgsave-error {{ stopwritesonbgsaveerror }}
{% endif %}

rdbcompression {{ rdbcompression }}
rdbchecksum {{ rdbchecksum }}

{% if dbfilename %}
dbfilename {{ dbfilename }}
{% else %}
dbfilename dump-{{ name }}.rdb
{% endif %}

dir {{ datadir }}

# Replication settings
{% if replicaof %}
replicaof {{ replicaof.address }} {{ replicaof.port }}
{% endif %}
{% if masterauth %}
masterauth {{ masterauth }}
{% endif %}
replica-serve-stale-data {{ replicaservestaledata }}
replica-read-only {{ replicareadonly }}
repl-diskless-sync {{ repldisklesssync }}
repl-diskless-sync-delay {{ repldisklesssyncdelay }}
repl-ping-replica-period {{ replpingreplicaperiod }}
repl-timeout {{ repltimeout }}
repl-disable-tcp-nodelay {{ repldisabletcpnodelay }}
repl-backlog-size {{ replbacklogsize }}
repl-backlog-ttl {{ replbacklogttl }}
replica-priority {{ replicapriority }}

# Security
{% if requirepass %}
requirepass {{ requirepass }}
{% endif %}
{% if rename_commands %}
{% for k, v in rename_commands.items() %}
rename-command {{ k }} {{ v if v else '""' }}
{% endfor %}
{% endif %}

# Limits
maxclients {{ maxclients }}
{% if maxmemory %}
maxmemory {{ maxmemory }}
{% endif %}
{% if maxmemorypolicy %}
maxmemory-policy {{ maxmemorypolicy }}
{% endif %}
{% if maxmemorysamples %}
maxmemory-samples {{ maxmemorysamples }}
{% endif %}

# Append Only File settings
appendonly {% if backuptype == 'aof' or backuptype == 'both' %}yes{% else %}no{% endif %}
{% if appendfilename %}
appendfilename {{ appendfilename }}
{% else %}
appendfilename appendonly-{{ name }}.aof
{% endif %}
appendfsync {{ appendfsync }}
no-appendfsync-on-rewrite {{ noappendfsynconrewrite }}
aof-rewrite-percentage {{ aofrewritepercentage }}
aof-rewrite-min-size {{ aofrewriteminsize }}
aof-load-truncated {{ aofloadtruncated }}

# Lua scripting
lua-time-limit {{ luatimelimit }}

# Slow log
slowlog-log-slower-than {{ slowloglogslowerthan }}
slowlog-max-len {{ slowlogmaxlen }}

# Keyspace notifications
notify-keyspace-events "{{ notifykeyspaceevents }}"

# Hashes, sets, zsets limits
hash-max-ziplist-entries {{ hashmaxziplistentries }}
hash-max-ziplist-value {{ hashmaxziplistvalue }}
set-max-intset-entries {{ setmaxintsetentries }}
zset-max-ziplist-entries {{ zsetmaxziplistentries }}
zset-max-ziplist-value {{ zsetmaxziplistvalue }}

# HLL
hll-sparse-max-bytes {{ hllsparsemaxbytes }}

# Active rehashing
activerehashing {{ activerehasing }}

# Client output buffer limits
{% for limit in clientoutputbufferlimit %}
client-output-buffer-limit {{ limit[0] }} {{ limit[1] }} {{ limit[2] }} {{ limit[3] }}
{% endfor %}

hz {{ hz }}

aof-rewrite-incremental-fsync {{ aofrewriteincrementalfsync }}

{% if clusterenabled == 'yes' %}
cluster-enabled yes
cluster-config-file {{ clusterconfigfile if clusterconfigfile else 'nodes-' + name + '.conf' }}
cluster-node-timeout {{ clusternodetimeout }}
{% if clusterport %}
cluster-port {{ clusterport }}
{% endif %}
{% endif %}

{% if includes %}
{% for include_option in includes %}
include {{ include_option }}
{% endfor %}
{% endif %}
